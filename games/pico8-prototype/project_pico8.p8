pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--variables

function _init()
  player={
    sp=0,
    x=0,
    y=0,
    w=8,
    h=8,
    speed = 1,
    anim=0,
    running=false,
    left = false,
    right = false,
    jumping=false,
    jump_frame=0,
    grounded = false,
    crouching=false,
  }
end  




	
-->8
--update and draw

function _update()
	player_move()
	player_animate()
end


function _draw()
	palt(10, true)
	palt(0,false)
	cls(13)
	map(0,0)
	spr(player.sp,player.x,player.y,1,1,player.flp)
end


-->8
--collisions

function collide_map(obj,aim,flag)
	--obj = table needs x,y,w,h
	--this function checks one pixel away from the character in each direction it faces
	local x = obj.x local y = obj.y
	local w = obj.w local h = obj.h
	
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim == "left" then
		x1 = x-1 y1 = y
		x2 = x   y2 = y+h-1
	
	elseif aim == "right" then
		x1= x+w    y1 = y
		x2 = x+w+1 y2 = y+h-1
		
	elseif aim == "up" then
		x1 =x      y1 = y-1
		x2 =x+w-1  y2 = y
	
	elseif aim == "down" then
		x1 =x       y1 =y+h 
		x2 =x+w-1   y2 =y+h 
		
	end	

	--pixels to tiles
	x1 = flr(x1 / 8)
	y1 = flr(y1 / 8)
	x2 = flr(x2 / 8)
	y2 = flr(y2 / 8)

--check flags to see if it is hitting a solid object
	if fget(mget(x1,y1),flag)
	or fget(mget(x1,y2),flag)
	or fget(mget(x2,y1),flag)
 or fget(mget(x2,y2),flag) then
  	return true
	
 else
  return false
 end
 
end
-->8
--player functions

function player_move()

	player.running = false
	player.left = false
	player.right = false
	
	--left
	if btn(⬅️) then
	
	  if not collide_map(player,"left",0) then
      player.x -= player.speed
    end
    
		player.left = true
		player.running = true
	end
	
	--right
	if btn(➡️) then
  if not collide_map(player,"right",0) then
    player.x += player.speed
   end
   
	 player.right = true
	 player.running = true
 end
 
 --jumping and falling
 if btnp(⬆️) and player.grounded then
 	player.grounded = false
  player.jumping = true
  player.jump_frame = 0
 end
 --jumpframes are so that the player goes up and then back down 
  if player.jumping then
    player.jump_frame += 1
	
		if player.jump_frame <= 10 then
			if not collide_map(player,"up",0) then
				player.y-=2
				
			else
				player.jumping= false
				end
		--makes check ground		
		else
			if not collide_map(player,"down",0) then
				player.y+=2
			else
				player.jumping = false
				player.grounded = true
			end
		end
			--jump complete
		if player.jump_frame >=20 then
			player.jumping = false
			end
	end
	
	if not player.jumping then

  if collide_map(player,"down",0) then
     player.grounded = true
				
  else
     player.grounded = false
     player.y += 2
  end
  end
 
 --crouching
 if btn(⬇️) and not player.crouching then
 	player.y +=2
 	player.crouching = true
	end
 	
 if not btn(⬇️) and player.crouching then
 	player.crouching = false
 	player.y -=2
 end
 
	-- screen boundaries
	if player.x < 0 then
		player.x = 0
	end
	
	if player.x > 120 then
		player.x = 120
	end
	
	if player.y < 0 then
		player.y = 0
	end
	
	if player.y > 120 then
		player.y = 120
	end
 
end
	
		
-->8
--animations

function player_animate()
		--label each sprite
  if player.jumping then
    player.sp = 5

  elseif player.crouching then
    player.sp = 6

  elseif player.running then
    player.anim += 1

     if player.left then
--make moving sprite alternate
        if player.anim < 5 then
           player.sp = 1

        else
           player.sp = 2
          end

      elseif player.right then

        if player.anim < 5 then
           player.sp = 3

        else
           player.sp = 4
         end
      end

    else
--reset
      player.sp = 0
      player.anim = 0
  end

  if player.anim >= 10 then
     player.anim = 0
  end
end
